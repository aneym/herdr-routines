#!/usr/bin/env node
import fs from 'node:fs/promises'
import net from 'node:net'
import path from 'node:path'
import { spawn } from 'node:child_process'
import { stringify, parse } from 'smol-toml'
import { getPaths } from '../src/lib/paths.js'
import { loadRoutines, writeRoutine } from '../src/lib/routines.js'
import { loadState } from '../src/lib/state.js'
import { readRuns } from '../src/lib/runstore.js'
import { assemblePreamble } from '../src/lib/preamble.js'

function parseArgs(argv) {
  const flags = {}
  const positional = []
  for (let index = 0; index < argv.length; index++) {
    const value = argv[index]
    if (!value.startsWith('--')) { positional.push(value); continue }
    const key = value.slice(2)
    if (['json', 'force', 'enabled', 'disabled', 'dry-run', 'edit', 'yes'].includes(key)) flags[key] = true
    else flags[key] = argv[++index]
  }
  return { flags, positional }
}

async function ctl(paths, request) {
  return await new Promise((resolve, reject) => {
    const socket = net.createConnection(paths.socketPath)
    let text = ''
    socket.setEncoding('utf8')
    socket.on('connect', () => socket.end(`${JSON.stringify(request)}\n`))
    socket.on('data', (chunk) => { text += chunk })
    socket.on('error', (error) => { error.daemonDown = ['ENOENT', 'ECONNREFUSED'].includes(error.code); reject(error) })
    socket.on('end', () => {
      try { const result = JSON.parse(text); result.ok ? resolve(result) : reject(new Error(result.error)) }
      catch (error) { reject(error) }
    })
  })
}

function triggerFromFlags(flags) {
  if (flags.cron) return { kind: 'cron', expr: flags.cron, ...(flags.tz ? { tz: flags.tz } : {}) }
  if (flags.every) return { kind: 'interval', every: flags.every }
  if (flags.at) return { kind: 'at', when: flags.at }
  if (flags.watch) return { kind: 'watch', every: flags.watch }
  return { kind: 'manual' }
}

async function openEditor(file) {
  const editor = process.env.EDITOR
  if (!editor) throw new Error('$EDITOR is not set')
  await new Promise((resolve, reject) => {
    const child = spawn(editor, [file], { stdio: 'inherit', shell: true })
    child.on('exit', (code) => code === 0 ? resolve() : reject(new Error(`editor exited ${code}`)))
  })
}

const { flags, positional } = parseArgs(process.argv.slice(2))
const session = flags.session || process.env.HERDR_SESSION || 'default'
const paths = getPaths(session)
const [command, id] = positional

try {
  if (command === 'list') {
    const routines = await loadRoutines(paths.configDir)
    const state = await loadState(paths.stateFile)
    const rows = []
    for (const [routineId, entry] of routines) {
      const last = (await readRuns(paths.runsDir, routineId, 1)).at(-1)
      rows.push({ id: routineId, name: entry.routine?.name || '-', state: entry.invalid ? `invalid: ${entry.invalid}` : state.routines[routineId]?.paused || (entry.routine.enabled ? 'enabled' : 'disabled'), last: last ? `${last.status} ${last.ts}` : '-', next: state.routines[routineId]?.nextRunAt || '-' })
    }
    if (flags.json) console.log(JSON.stringify(rows, null, 2))
    else console.table(rows)
  } else if (command === 'get') {
    const entry = (await loadRoutines(paths.configDir)).get(id)
    if (!entry) throw new Error(`routine not found: ${id}`)
    console.log(JSON.stringify({ ...entry, state: (await loadState(paths.stateFile)).routines[id], runs: await readRuns(paths.runsDir, id, 10) }, null, 2))
  } else if (command === 'create') {
    if (!id || !flags.name || !flags.agent || (!flags.prompt && !flags['prompt-file'])) throw new Error('create requires id, --name, --agent, and --prompt or --prompt-file')
    const prompt = flags.prompt ?? await fs.readFile(flags['prompt-file'], 'utf8')
    const routine = { name: flags.name, agent: flags.agent, prompt, enabled: !flags.disabled, trigger: triggerFromFlags(flags), run: { target: flags.target || 'isolated', workspace: flags.workspace || '⚡ routines', cwd: flags.cwd || '~' }, delivery: { notify: flags.notify || 'always' } }
    console.log(await writeRoutine(paths.configDir, id, routine, flags.force))
  } else if (command === 'edit') {
    const file = path.join(paths.configDir, `${id}.toml`)
    await openEditor(file)
    const raw = parse(await fs.readFile(file, 'utf8'))
    const { validateRoutine } = await import('../src/lib/routines.js')
    validateRoutine(id, raw)
  } else if (command === 'enable' || command === 'disable') {
    const file = path.join(paths.configDir, `${id}.toml`)
    const raw = parse(await fs.readFile(file, 'utf8'))
    raw.enabled = command === 'enable'
    await fs.writeFile(file, stringify(raw))
  } else if (command === 'pause' || command === 'resume') {
    try { await ctl(paths, { cmd: command, id }) }
    catch (error) {
      if (!error.daemonDown) throw error
      const file = path.join(paths.configDir, `${id}.toml`)
      const raw = parse(await fs.readFile(file, 'utf8'))
      raw.enabled = command === 'resume'
      await fs.writeFile(file, `# ${command} applied while daemon was down\n${stringify(raw)}`)
    }
  } else if (command === 'run') {
    if (flags['dry-run']) {
      const entry = (await loadRoutines(paths.configDir)).get(id)
      if (!entry?.routine) throw new Error(entry?.invalid || `routine not found: ${id}`)
      const runs = await readRuns(paths.runsDir, id, 1)
      const prompt = assemblePreamble({ routine: entry.routine, runNumber: ((await loadState(paths.stateFile)).routines[id]?.runCount || 0) + 1, lastRun: runs.at(-1), notesPath: path.join(paths.notesDir, `${id}.md`) })
      console.log(`${prompt}\n\nPlanned API calls: workspace.list/create, tab.create, agent start/detect, agent.prompt, agent.read, notification.show, tab.close(retention)`)
    } else console.log(JSON.stringify((await ctl(paths, { cmd: 'run', id })).run, null, 2))
  } else if (command === 'fire') {
    const payload = flags['payload-json'] ? JSON.parse(flags['payload-json']) : undefined
    console.log(JSON.stringify((await ctl(paths, { cmd: 'fire', id, token: flags.token, payload })).run, null, 2))
  } else if (command === 'runs') {
    console.log((await readRuns(paths.runsDir, id, Number(flags.n || 20))).map((run) => JSON.stringify(run)).join('\n'))
  } else if (command === 'logs') {
    const last = (await readRuns(paths.runsDir, id, 1)).at(-1)
    console.log(last?.output_tail || last?.summary || '')
  } else if (command === 'notes') {
    const file = path.join(paths.notesDir, `${id}.md`)
    await fs.mkdir(paths.notesDir, { recursive: true })
    try { await fs.access(file) } catch { await fs.writeFile(file, '') }
    if (flags.edit) await openEditor(file)
    else console.log(file)
  } else if (command === 'delete') {
    if (!flags.yes) throw new Error('delete requires --yes')
    await fs.unlink(path.join(paths.configDir, `${id}.toml`))
  } else if (command === 'status') {
    console.log(JSON.stringify(await ctl(paths, { cmd: 'status' }), null, 2))
  } else if (command === 'doctor') {
    const checks = { configReadable: true, rosterPresent: true, daemonUp: true, sessionReachable: true, invalidRoutines: [] }
    try { await fs.access(paths.configDir) } catch { checks.configReadable = false }
    try { await fs.access(process.env.HERDR_ROUTINES_ROSTER || path.join(process.env.HOME, '.config/herdr/spawn-agents.conf')) } catch { checks.rosterPresent = false }
    try { await ctl(paths, { cmd: 'status' }) } catch { checks.daemonUp = false }
    try { await fs.access(session === 'default' ? path.join(process.env.HOME, '.config/herdr/herdr.sock') : path.join(process.env.HOME, '.config/herdr/sessions', session, 'herdr.sock')) } catch { checks.sessionReachable = false }
    for (const [routineId, entry] of await loadRoutines(paths.configDir)) if (entry.invalid) checks.invalidRoutines.push({ id: routineId, error: entry.invalid })
    console.log(JSON.stringify(checks, null, 2))
    if (!checks.configReadable || !checks.rosterPresent || !checks.daemonUp || !checks.sessionReachable || checks.invalidRoutines.length) process.exitCode = 1
  } else throw new Error('usage: herdr-routines list|get|create|edit|enable|disable|pause|resume|run|fire|runs|logs|notes|delete|status|doctor')
} catch (error) {
  console.error(error.message)
  process.exitCode = error.daemonDown ? 2 : 1
}
